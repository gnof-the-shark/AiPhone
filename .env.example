# ── AiPhone configuration ────────────────────────────────────────────────────
#
# Copy this file to .env and fill in the values.
# Variables already in the environment take precedence over .env.

# Port the HTTP server listens on (default: 3000)
PORT=3000

# Your ClawPhone API key — obtained from POST /v1/auth/register/verify.
# This key is used for TWO things:
#   1. Authenticating agents that call AiPhone  (Authorization: Bearer header)
#   2. Authenticating AiPhone's outbound calls  to api.clawphone.me
# Keep this secret — never commit it to source control.
CLAWPHONE_API_KEY=clawphone_sk_xxxxxxxxxxxxxxxxxxxx

# Backward-compatible alias supported by AiPhone.
# CLAW_API_KEY=clawphone_sk_xxxxxxxxxxxxxxxxxxxx

# Optional: override the bearer token agents must send to AiPhone.
# Defaults to CLAWPHONE_API_KEY when not set.
# API_TOKEN=

# Optional: override the ClawPhone API base URL (useful for self-hosted gateways).
# CLAWPHONE_API_URL=https://api.clawphone.me/v1

# Optional: maximum SMS body length in characters (default: 1600 = 10 segments).
# SMS_BODY_MAX_CHARS=1600

# Optional: how long (ms) an Idempotency-Key is remembered (default: 86400000 = 24 h).
# IDEMPOTENCY_TTL_MS=86400000

# Google Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: List of E.164 phone numbers allowed to interact with the AI (comma-separated).
# If empty, all numbers are allowed.
# ALLOWED_NUMBERS=+14383389459
