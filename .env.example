# ── AiPhone configuration ────────────────────────────────────────────────────
#
# Copy this file to .env and fill in the values.
# Variables already in the environment take precedence over .env.

# Port the HTTP server listens on (default: 3000)
PORT=3000

# ── Twilio ────────────────────────────────────────────────────────────────────
# Your Twilio Account SID and Auth Token (from console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio phone number in E.164 format (e.g. +15140001234)
TWILIO_PHONE_NUMBER=+15140001234

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# ── Phone numbers ─────────────────────────────────────────────────────────────
# Comma-separated E.164 numbers that are allowed to exchange SMS with Gemini.
# Gemini will also proactively message these numbers.
ALLOWED_NUMBERS=+14383389459

# ── Proactive messaging ───────────────────────────────────────────────────────
# How often (ms) Gemini considers sending a proactive message. Default: 4 hours.
# PROACTIVE_INTERVAL_MS=14400000
