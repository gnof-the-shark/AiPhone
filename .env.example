# ── AiPhone configuration ────────────────────────────────────────────────────
#
# Copie ce fichier en .env et remplis les valeurs.
# Les variables déjà dans l'environnement ont priorité sur .env.

# Port d'écoute du serveur HTTP (défaut: 3000)
PORT=3000

# ── Android / ADB ────────────────────────────────────────────────────────────
# Série ADB de l'émulateur (défaut: emulator-5554)
ADB_DEVICE=emulator-5554

# Chemin vers le binaire adb (défaut: 'adb' — suppose qu'il est dans PATH)
# ADB_PATH=/home/user/android-sdk/platform-tools/adb

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=ta_cle_gemini_ici

# Modèle Gemini (défaut: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# ── Numéros autorisés ─────────────────────────────────────────────────────────
# Numéros E.164 séparés par des virgules qui peuvent échanger des SMS avec Gemini.
# C'est aussi la liste des numéros que Gemini peut contacter de façon proactive.
# Mets ici TON numéro de téléphone personnel (pas le numéro Fongo).
ALLOWED_NUMBERS=+14383389459

# ── Intervalles ───────────────────────────────────────────────────────────────
# À quelle fréquence (ms) le serveur vérifie les nouvelles notifications Fongo.
# Défaut: 5000 (5 secondes)
# POLL_INTERVAL_MS=5000

# À quelle fréquence (ms) Gemini envisage d'envoyer un message proactif.
# Défaut: 14400000 (4 heures)
# PROACTIVE_INTERVAL_MS=14400000
